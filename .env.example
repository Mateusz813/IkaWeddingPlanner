# Podłączenie arkusza Google „na sztywno" — dzięki temu nikt nie musi niczego
# wklejać w aplikacji. Te same dwie wartości ustaw w Vercelu:
# Settings → Environment Variables (dla wszystkich środowisk).
#
# Skopiuj ten plik jako .env (jest w .gitignore, nie trafi do repozytorium).

VITE_SHEETS_URL=https://script.google.com/macros/s/TU_WKLEJ_SWOJ_ADRES/exec
VITE_SHEETS_TOKEN=tu-wklej-haslo-z-linii-18-w-Kod.gs
